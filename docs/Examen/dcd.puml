package "Domain.Enums" {
  enum AnonymizationStatus {
    Suggested
    Approved
    Rejected
    Anonymized
  }
  enum DbConnectionState {
    Online
    Offline
    Reconnecting
    Unknown
  }
  enum Department {
    Slottet
    Skoven
    Marken
  }
  enum IncidentSeverity {
    Low
    Medium
    High
    Critical
  }
  enum IncidentStatus {
    Open
    UnderInvestigation
    Closed
    Escalated
    BreachNotified
  }
  enum RetentionDataCategory {
    MedicineLogs
    ResidentNotes
    AuditLogs
    LoginLogs
    InactiveUsers
    AnonymizationTrigger
  }
  enum ShiftType {
    Day
    Evening
    Night
  }
  enum TrafficLightStatus {
    Green
    Yellow
    Red
  }
  enum TaskListStatus {
    Success
    InProgress
  }
}

package "Domain.Interfaces" {
  interface IEntity {
    +Id: guid
  }
}

