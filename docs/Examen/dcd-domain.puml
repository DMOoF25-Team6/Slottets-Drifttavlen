@startuml
skinparam classAttributeIconSize 0
left to right direction

package "Microsoft.AspNetCore.Identity" {
  class "IdentityUser<Guid>" as IdentityUserGuid <<external>>
}

package "Domain.Enums" {
  enum AnonymizationStatus {
    Pending
    Approved
    Rejected
    Postponed
    OnHold
    Completed
  }
  enum DbConnectionState {
    Online
    Offline
    Reconnecting
    Unknown
  }
  enum Department {
    Slottet
    Skoven
    Marken
  }
  enum IncidentSeverity {
    Low
    Medium
    High
    Critical
  }
  enum IncidentStatus {
    Open
    UnderInvestigation
    Closed
    Escalated
    BreachNotified
  }
  enum RetentionDataCategory {
    MedicineLogs
    ResidentNotes
    AuditLogs
    LoginLogs
    InactiveUsers
    AnonymizationTrigger
  }
  enum ShiftType {
    Day
    Evening
    Night
  }
  enum TrafficLightStatus {
    Green
    Yellow
    Red
  }
  enum TaskListStatus {
    Success
    InProgress
  }
}

package "Domain.Interfaces" {
  interface IEntity {
    +Id: guid
  }
}

package "Domain.Entities" {
  class AnonymizationCandidate {
    +Id: guid
    +ResidentId: guid
    +RetentionPolicyId: guid
    +SuggestedAt: DateTime
    +Reason: string
    +Status: AnonymizationStatus
    +Resident: Resident
    +RetentionPolicy: RetentionPolicy
  }
  class AuditEntry {
    +Id: guid
    +Metadata: string
    +StartTimeUtc: DateTime
    +EndTimeUtc: DateTime
    +Succeeded: bool
    +UserId: guid
    +ErrorMessage: string
    +ChangeDetails: ICollection<ChangeDetail>
  }
  class ChangeDetail {
    +Id: guid
    +Field: string
    +OldValue: string
    +NewValue: string
    +AuditEntryId: guid
  }
  class Employee {
    +Id: guid
    +FirstName: string
    +LastName: string
    +Initials: string
    +UserId: guid
    +StaffAssignments: ICollection<StaffAssignment>
    +Department: Department
    +User: User
  }
  class LoginAttempt {
    +Id: guid
    +AttemptedAt: DateTime
    +EmailHash: string
    +UserId: guid
    +Succeeded: bool
    +IpAddress: string
    +FailureReason: string
  }
  class MedicineRecord {
    +Id: guid
    +ResidentId: guid
    +MedicineName: string
    +Timestamp: DateTime
    +Given: bool
  }
  class PainkillerRecord {
    +Id: guid
    +ResidentId: guid
    +Type: string
    +GivenAt: DateTime
    +NextAllowedTime: DateTime
  }
  class PhoneAssignment {
    +Id: guid
    +CaregiverId: guid
    +PhoneNumber: string
    +ShiftType: string
    +ShiftTypeEnum: ShiftType
  }
  class RefreshToken {
    +Id: guid
    +UserId: guid
    +TokenHash: string
    +ExpiresAt: DateTime
    +CreatedAt: DateTime
    +RevokedAt: DateTime Nullable
    +CreatedByIp: string Nullable
    +RevokedReason: string Nullable
    +User: User
  }
  class Resident {
    +Id: guid
    +Initials: string
    +FirstName: string
    +LastName: string
    +TrafficLightStatus: TrafficLightStatus
    +Department: Department
    +DischargedAt: DateTime Nullable
    +Notes: ICollection<ResidentNote>
    +Medicines: ICollection<MedicineRecord>
    +Painkillers: ICollection<PainkillerRecord>
    +StaffAssignments: ICollection<StaffAssignment>
  }
  class ResidentNote {
    +Id: guid
    +Note: string
    +CreatedAt: DateTime
    +EditedAt: DateTime
    +ResidentId: guid
  }
  class RetentionPolicy {
    +Id: guid
    +Category: RetentionDataCategory
    +RetentionPeriod: TimeSpan
    +LegalMinimum: TimeSpan
    +EffectiveFrom: DateTime
    +AuditHistory: ICollection<RetentionPolicyAudit>
    +Candidates: ICollection<AnonymizationCandidate>
  }
  class RetentionPolicyAudit {
    +Id: guid
    +RetentionPolicyId: guid
    +ChangedByEmployeeId: guid
    +PreviousPeriod: TimeSpan
    +NewPeriod: TimeSpan
    +ChangedAt: DateTime
    +Reason: string
    +RetentionPolicy: RetentionPolicy
  }
  class SecurityIncident {
    +Id: guid
    +DetectedAt: DateTime
    +Type: string
    +Severity: IncidentSeverity
    +Status: IncidentStatus
    +InvestigationNotes: string
    +ReportedByEmployeeId: guid Nullable
    +ResolvedByEmployeeId: guid Nullable
  }
  class StaffAssignment {
    +Id: guid
    +ResidentId: guid
    +EmployeeId: guid
    +ShiftType: ShiftType
    +AssignmentDate: DateTime
    +CreatedAt: DateTime
    +UpdatedAt: DateTime Nullable
    +Resident: Resident
    +Employee: Employee
  }
  class SubjectAccessRequest {
    +Id: guid
    +ResidentId: guid
    +RequestedByEmployeeId: guid
    +RequestedAt: DateTime
    +ScopeOptions: string
    +ExportFileName: string
    +ExportGeneratedAt: DateTime
    +FulfilledAt: DateTime Nullable
    +FulfilledByEmployeeId: guid Nullable
    +Resident: Resident
  }
  class TaskList {
    +Id: guid
    +Title: string
    +Description: string
    +TaskStatus: TaskListStatus
    +DueTime: DateTime
    +Department: Department
  }
  class User {
    +Id: guid
    +UserName: string
    +Department: Department Nullable
  }
}

package "Domain.UiModels" {
  class DataConnection {
    +State: DbConnectionState
    +LastChecked: DateTime Nullable
    +ErrorMessage: string
  }
}

IdentityUserGuid <|-- User

IEntity <|.. AnonymizationCandidate
IEntity <|.. AuditEntry
IEntity <|.. ChangeDetail
IEntity <|.. Employee
IEntity <|.. LoginAttempt
IEntity <|.. MedicineRecord
IEntity <|.. PainkillerRecord
IEntity <|.. PhoneAssignment
IEntity <|.. RefreshToken
IEntity <|.. Resident
IEntity <|.. ResidentNote
IEntity <|.. RetentionPolicy
IEntity <|.. RetentionPolicyAudit
IEntity <|.. SecurityIncident
IEntity <|.. StaffAssignment
IEntity <|.. SubjectAccessRequest
IEntity <|.. TaskList
IEntity <|.. User

AuditEntry "1" *-- "0..*" ChangeDetail : ChangeDetails
Resident "1" *-- "0..*" ResidentNote : Notes
Resident "1" *-- "0..*" MedicineRecord : Medicines
Resident "1" *-- "0..*" PainkillerRecord : Painkillers
RetentionPolicy "1" *-- "0..*" RetentionPolicyAudit : AuditHistory
RetentionPolicy "1" *-- "0..*" AnonymizationCandidate : Candidates

Employee "1" o-- "0..*" StaffAssignment : StaffAssignments
Resident "1" o-- "0..*" StaffAssignment : StaffAssignments

Employee "0..1" <-- "1" User : UserId
User "1" <-- "0..*" AuditEntry : UserId
User "1" <-- "0..*" LoginAttempt : UserId
User "1" <-- "0..*" RefreshToken : UserId

Resident "1" <-- "0..*" AnonymizationCandidate : ResidentId
RetentionPolicy "1" <-- "0..*" AnonymizationCandidate : RetentionPolicyId
Resident "1" <-- "0..*" SubjectAccessRequest : ResidentId
Employee "1" <-- "0..*" SubjectAccessRequest : RequestedByEmployeeId
Employee "1" <-- "0..*" SubjectAccessRequest : FulfilledByEmployeeId

RetentionPolicy "1" <-- "0..*" RetentionPolicyAudit : RetentionPolicyId
Employee "1" <-- "0..*" RetentionPolicyAudit : ChangedByEmployeeId

Resident "1" <-- "0..*" MedicineRecord : ResidentId
Resident "1" <-- "0..*" PainkillerRecord : ResidentId
Resident "1" <-- "0..*" ResidentNote : ResidentId
Resident "1" <-- "0..*" StaffAssignment : ResidentId
Employee "1" <-- "0..*" StaffAssignment : EmployeeId

Employee "1" <-- "0..*" SecurityIncident : ReportedByEmployeeId
Employee "1" <-- "0..*" SecurityIncident : ResolvedByEmployeeId

Employee --> Department : Department
Resident --> Department : Department
Resident --> TrafficLightStatus : TrafficLightStatus
TaskList --> TaskListStatus : TaskStatus
TaskList --> Department : Department
StaffAssignment --> ShiftType : ShiftType
PhoneAssignment ..> ShiftType : ShiftTypeEnum
AnonymizationCandidate --> AnonymizationStatus : Status
RetentionPolicy --> RetentionDataCategory : Category
SecurityIncident --> IncidentSeverity : Severity
SecurityIncident --> IncidentStatus : Status
DataConnection ..> DbConnectionState : State

@enduml
